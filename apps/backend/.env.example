# Server — Catto Software Solutions dev ports: backend 4222 (frontend 3222)
PORT=4222
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Auth
JWT_SECRET=your-jwt-secret
JWT_EXPIRATION=7d

# Services (optional — uncomment as needed)
# SENDGRID_API_KEY=
# STRIPE_SECRET_KEY=
# FIREBASE_SERVICE_ACCOUNT_JSON=
# RECAPTCHA_SECRET_KEY=

# Contact form -> SMS notifications (Telnyx, via @ccatto/nest-sms)
# TELNYX_API_KEY=
# TELNYX_PHONE_NUMBER=+15551234567
# TELNYX_MESSAGING_PROFILE_ID=
# ADMIN_PHONE=+15551234567        # where contact-form texts are delivered

# CORS — in production set this to your deployed frontend origin
# CORS_ORIGIN=https://cattosoftwaresolutions.com
