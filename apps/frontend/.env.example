# App — Catto Software Solutions dev ports: frontend 3222, backend 4222
NEXT_PUBLIC_BASE_URL=http://localhost:3222
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4222/graphql

# Google Analytics (GA4) — public Measurement ID (G-XXXXXXXXXX).
# Leave blank to disable analytics (recommended for local dev so browsing
# doesn't pollute the GA property). Production value is baked into the Dockerfile.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Auth (Better Auth)
BETTER_AUTH_SECRET=your-secret-here
BETTER_AUTH_URL=http://localhost:3222

# OAuth Providers (optional — uncomment and configure as needed)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Database — REQUIRED. Better Auth runs inside the Next.js server, so the
# frontend needs the SAME DATABASE_URL as the backend (apps/backend/.env.local),
# or email/password sign-up will 500. Use your real (e.g. Neon) connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/myapp

# Services (optional)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# SENDGRID_API_KEY=
